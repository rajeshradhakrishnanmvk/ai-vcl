    },
    {
      "path": "./projects/vcl-actions/tsconfig.lib.json"
    },
    {
      "path": "./projects/vcl-actions/tsconfig.spec.json"
    },
    {
      "path": "./projects/vcl-dialogs/tsconfig.lib.json"
    },
    {
      "path": "./projects/vcl-dialogs/tsconfig.spec.json"
    },
    {
      "path": "./projects/vcl-theming/tsconfig.lib.json"
